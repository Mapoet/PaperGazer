# PaperGazer 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到版本控制（已在 .gitignore 中）

# 联系邮箱（用于 Crossref/Unpaywall API 礼貌池）
# 优先级：环境变量 > 配置文件
MAILTO=your-email@domain.com

# 或者使用带前缀的格式（pydantic-settings 自动处理）
# PAPERGAZER_MAILTO=your-email@domain.com

# API密钥（如果未来需要）
# API_KEY=your-api-key-here
# 或者
# PAPERGAZER_API_KEY=your-api-key-here
