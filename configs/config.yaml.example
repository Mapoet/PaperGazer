# PaperGazer 配置文件示例
# 复制此文件为 config.yaml 并修改相应配置

# 联系邮箱（用于 Crossref/Unpaywall API 礼貌池）
mailto: "your-email@domain.com"

# arXiv 配置（测试时使用较小值）
arxiv:
  categories:
    # 原有分类
    - "eess.SP"              # Signal Processing
    - "physics.space-ph"      # Space Physics
    # 地学领域
    - "physics.geo-ph"        # Geophysics
    - "physics.ao-ph"         # Atmospheric and Oceanic Physics
    # 遥感领域
    - "cs.CV"                 # Computer Vision (遥感图像处理)
    - "eess.IV"               # Image and Video Processing (遥感图像处理)
    # 人工智能领域
    - "cs.AI"                 # Artificial Intelligence
    - "cs.LG"                 # Machine Learning
    - "cs.NE"                 # Neural and Evolutionary Computing
    - "cs.CL"                 # Computation and Language (自然语言处理)
    - "stat.ML"               # Machine Learning (统计学)
  max_results: 50  # 增加结果数以便测试
  delay_seconds: 3

# 期刊配置
journals:
  issn:
    # CNS 期刊
    nature:
      - "0028-0836"           # print
      - "1476-4687"           # online
    science:
      - "0036-8075"           # print
      - "1095-9203"           # online
